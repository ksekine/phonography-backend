{
  "name": "phonography-backend",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "dev": "wrangler dev --env dev",
    "logs:dev": "wrangler tail --env dev",
    "logs:prod": "wrangler tail --env prod",
    "deploy:dev": "wrangler deploy --env dev --minify",
    "deploy:prod": "wrangler deploy --env prod --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --env dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --env dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env prod --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
